# --- AI 模型 ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# --- 360 Quake ---
QUAKE_API_KEY=

# --- 奇安信 Hunter ---
HUNTER_API_KEY=

# --- 代理 (可选) ---
HTTP_PROXY=
HTTPS_PROXY=
